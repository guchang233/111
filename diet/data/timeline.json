 "captions": [
  {
   "t0": 12.0,
   "t1": 14.85,
   "text": "她瘦了。",
   "preset": "line"
  },
  {
   "t0": 15.0,
   "t1": 17.85,
   "text": "她也更胖了。",
   "preset": "line",
   "color": "red"
  },
  {
   "t0": 21.0,
   "t1": 45.0,
   "text": "一 · 秤不会告诉你的事",
   "preset": "kicker"
  },
  {
   "t0": 27.0,
   "t1": 32.7,
   "text": "秤只告诉你，你轻了。",
   "preset": "line"
  },
  {
   "t0": 33.0,
   "t1": 38.7,
   "text": "它不告诉你，轻掉的是什么。",
   "preset": "line"
  },
  {
   "t0": 39.0,
   "t1": 41.85,
   "text": "体重正常，体脂超标。",
   "preset": "line"
  },
  {
   "t0": 42.0,
   "t1": 44.85,
   "text": "医学上有个名字：正常体重肥胖。",
   "preset": "line"
  },
  {
   "t0": 45.0,
   "t1": 78.0,
   "text": "二 · 1944 年，明尼苏达",
   "preset": "kicker"
  },
  {
   "t0": 48.0,
   "t1": 53.7,
   "text": "36 个健康的年轻男人。",
   "preset": "line"
  },
  {
   "t0": 54.0,
   "t1": 56.85,
   "text": "网上流行的「1200 大卡减肥餐」，比这还少。",
   "preset": "line"
  },
  {
   "t0": 60.0,
   "t1": 61.35,
   "text": "他们开始收藏菜谱。",
   "preset": "mid",
   "y": 430,
   "size": 40
  },
  {
   "t0": 61.5,
   "t1": 62.85,
   "text": "梦里全是食物。",
   "preset": "mid",
   "y": 500,
   "size": 40
  },
  {
   "t0": 63.0,
   "t1": 64.35,
   "text": "易怒，抑郁，",
   "preset": "mid",
   "y": 570,
   "size": 40
  },
  {
   "t0": 64.5,
   "t1": 65.85,
   "text": "没法集中注意力。",
   "preset": "mid",
   "y": 640,
   "size": 40
  },
  {
   "t0": 66.0,
   "t1": 68.85,
   "text": "实验结束，可以随便吃了。",
   "preset": "line"
  },
  {
   "t0": 69.0,
   "t1": 71.85,
   "text": "他们停不下来。",
   "preset": "line",
   "color": "red"
  },
  {
   "t0": 75.0,
   "t1": 77.85,
   "text": "越瘦的人，多长得越多。",
   "preset": "line"
  },
  {
   "t0": 78.0,
   "t1": 99.0,
   "text": "三 · 身体会记仇",
   "preset": "kicker"
  },
  {
   "t0": 78.0,
   "t1": 83.7,
   "text": "14 名《超级减肥王》选手。",
   "preset": "line"
  },
  {
   "t0": 90.0,
   "t1": 95.7,
   "text": "他们的身体，每天仍比预期少烧约 500 大卡。",
   "preset": "line"
  },
  {
   "t0": 96.0,
   "t1": 98.85,
   "text": "整整 6 年。",
   "preset": "line",
   "color": "red"
  },
  {
   "t0": 99.0,
   "t1": 117.0,
   "text": "四 · 16 岁，没有第二次",
   "preset": "kicker"
  },
  {
   "t0": 102.0,
   "t1": 107.7,
   "text": "18 岁之前，你会长出一生骨量的 90%。",
   "preset": "line"
  },
  {
   "t0": 108.0,
   "t1": 112.2,
   "text": "饿没了的月经，饿没了的骨量，",
   "preset": "line"
  },
  {
   "t0": 112.5,
   "t1": 116.7,
   "text": "有些，不会再回来。",
   "preset": "line",
   "color": "red"
  },
  {
   "t0": 117.0,
   "t1": 126.0,
   "text": "五 · 谁在教你饿",
   "preset": "kicker"
  },
  {
   "t0": 126.0,
   "t1": 144.0,
   "text": "六 · 越减越胖",
   "preset": "kicker"
  },
  {
   "t0": 126.0,
   "t1": 131.7,
   "text": "2516 名青少年，追踪 5 年。",
   "preset": "line"
  },
  {
   "t0": 132.0,
   "t1": 137.7,
   "text": "用节食这类方法控制体重的人，5 年后——",
   "preset": "line"
  },
  {
   "t0": 138.0,
   "t1": 143.7,
   "text": "神经性厌食，死亡率是同龄人的约 6 倍。",
   "preset": "line"
  },
  {
   "t0": 144.0,
   "t1": 171.0,
   "text": "七 · 那怎么办",
   "preset": "kicker",
   "warm": true
  },
  {
   "t0": 156.0,
   "t1": 160.2,
   "text": "体重不是你的分数。",
   "preset": "mid",
   "y": 540,
   "size": 64,
   "warm": true
  },
  {
   "t0": 160.5,
   "t1": 164.7,
   "text": "如果你已经停不下来，这不是意志力的问题，",
   "preset": "line",
   "warm": true
  },
  {
   "t0": 163.5,
   "t1": 167.7,
   "text": "是一种需要、也可以被治疗的病。",
   "preset": "line",
   "warm": true
  }
 ],
